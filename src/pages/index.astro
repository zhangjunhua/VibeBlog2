---
import PostList from "../components/PostList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
import { getPublishedPosts } from "../utils/posts";
import { withBase } from "../utils/paths";

const posts = await getPublishedPosts();
---

<BaseLayout>
  <section class="shell hero">
    <p class="eyebrow">Notes on learning & life</p>
    <h1>
      记录学习，
      <br />
      也记录生活。
    </h1>
    <p class="hero-description">{site.description}</p>
  </section>
  <section class="shell content page-section" aria-labelledby="recent-posts">
    <div class="section-heading">
      <h2 id="recent-posts">最近文章</h2>
      <a class="text-link" href={withBase("/blog/")}>
        查看全部 →
      </a>
    </div>
    <PostList posts={posts.slice(0, 3)} headingLevel="h3" />
  </section>
</BaseLayout>
