---
import BaseLayout from "./BaseLayout.astro";
import type { BlogPost } from "../utils/posts";
import { formatDate, toDateAttribute } from "../utils/posts";
import { withBase } from "../utils/paths";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <article class="shell content">
    <header class="article-header">
      <a class="back-link" href={withBase("/blog/")}>
        ← 返回全部文章
      </a>
      <h1>{post.data.title}</h1>
      <p class="article-meta">
        <time datetime={toDateAttribute(post.data.pubDate)}>
          发布于 {formatDate(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <time datetime={toDateAttribute(post.data.updatedDate)}>
            更新于 {formatDate(post.data.updatedDate)}
          </time>
        )}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
