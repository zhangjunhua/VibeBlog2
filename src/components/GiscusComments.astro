---
import { comments } from "../comments.config";

interface Props {
  postId: string;
}

const { postId } = Astro.props;

if (comments.enabled && (!comments.repoId || !comments.categoryId)) {
  throw new Error("启用评论前必须完整配置 Giscus repoId 和 categoryId。");
}
---

{comments.enabled && (
  <section
    class="shell content comments-section"
    aria-labelledby="comments-title"
  >
    <h2 id="comments-title">评论</h2>
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={comments.repo}
      data-repo-id={comments.repoId}
      data-category={comments.category}
      data-category-id={comments.categoryId}
      data-mapping="specific"
      data-term={`blog:${postId}`}
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="zh-CN"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </section>
)}
